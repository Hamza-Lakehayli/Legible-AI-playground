# Runtime data plane (never exposed to the browser)

# Postgres with a runtime-role connection string (M3 wires this in)
# DATABASE_URL="postgresql://runtime_user:password@host/db"

# Ed25519 public key that verifies tokens minted by the web app (base64url raw bytes)
# RUNTIME_TOKEN_PUBLIC_KEY="base64url-encoded raw public key"

# NVIDIA NIM (OpenAI-compatible, free tier)
# NVIDIA_API_KEY="nvapi-..."
# Optional fallback must support the same tools; unset means no model switch.
# FALLBACK_MODEL="meta/llama-3.1-8b-instruct"
# MODEL_REQUEST_BUDGET_SECONDS=60
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Redis-backed quotas/limiter (M5)
# REDIS_URL="redis://..."

# CORS: the web app's origin
# ALLOWED_ORIGIN="http://localhost:3000"
